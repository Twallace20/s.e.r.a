{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sera://contracts/development-tasks/task-contract-manifest-schema-v1.json",
  "title": "S.E.R.A. Development Agent Task Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "title",
    "created",
    "manager",
    "status",
    "operatingMode",
    "allowedPaths",
    "allowedActions",
    "networkPolicy",
    "forbiddenActions",
    "acceptanceCriteria",
    "requiredEvidence",
    "managerApproval",
    "humanDecisionPoint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "taskId": {
      "type": "string",
      "pattern": "^DA-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "manager": {
      "const": "Tyler Wallace"
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "IN_PROGRESS",
        "REVIEW_REQUIRED",
        "PASSED",
        "FAILED",
        "BLOCKED",
        "CLOSED"
      ]
    },
    "operatingMode": {
      "enum": [
        "read_only",
        "propose_patch",
        "approved_implementation"
      ]
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "git_status_short",
          "git_log_head",
          "git_ls_files",
          "git_grep",
          "read_approved_files",
          "npm_build",
          "npm_test",
          "base_mvp_verify_existing_release"
        ]
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "permittedEndpoints"
      ],
      "properties": {
        "mode": {
          "enum": [
            "denied",
            "loopback_only",
            "approved_research_only"
          ]
        },
        "permittedEndpoints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "forbiddenActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3}$"
          },
          "condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requiredEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "managerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedBy",
        "approvalDate",
        "approvedMode"
      ],
      "properties": {
        "approvedBy": {
          "const": "Tyler Wallace"
        },
        "approvalDate": {
          "type": "string",
          "format": "date"
        },
        "approvedMode": {
          "enum": [
            "read_only",
            "propose_patch",
            "approved_implementation"
          ]
        }
      }
    },
    "humanDecisionPoint": {
      "type": "string",
      "minLength": 1
    }
  }
}