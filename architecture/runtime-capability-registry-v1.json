        "requestAuthority": "unified-control-plane",
        "executionAuthority": "execution-authority",
        "stateAuthority": "runtime-state",
        "evidenceAuthority": "runtime-state",
        "selfAuthorizationAllowed": false
      },
      "resourceTypes": [
        {
          "id": "task-request",
          "description": "Real governed task request",
          "requiresRealResource": true,
          "proofState": "certified"
        }
      ],
      "existingEvidence": [
        "packages/runtime-capability-composition/src/governed-planner-composition.ts",
        "evidence/milestone-5/latest/proof-report.json"
      ],
      "knownLimitations": [
        "certification is bounded to governed task-request persistence and planning-only behavior",
        "planner requests do not execute work or self-authorize terminal state"
      ]
    },
