{
  "schemaVersion": "sera.runtime-capability-registry.v1",
  "milestone": 5,
  "purpose": "Canonical runtime-operability and composition registry. This registry does not replace repository inventory or portable-release claim/proof state.",
  "authorityRule": "Registered capabilities cannot self-authorize execution, terminal state, certification, or promotion.",
  "realResourceProofRule": {
    "requiredForExternalCapabilityClaims": true,
    "syntheticFixtureCanCertifyFormatClaim": false,
    "requiredEvidence": [
      "resource-identity-or-provenance",
      "expected-result",
      "actual-result",
      "validation-assertions",
      "evidence-reference",
      "failure-path",
      "clean-closeout"
    ],
    "multiFormatRule": "Every advertised resource format requires its own representative real-resource proof."
  },
  "capabilities": [
